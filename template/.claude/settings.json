{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "WebSearch"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(terraform:*)",
      "Bash(tofu:*)",
      "Bash(terragrunt:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/*secret*)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/*secret*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(chmod:*)"
    ]
  },
  "agent": "orchestrator"
}
